# Kopiraj u .env za lokalni razvoj; u produkciji postavi u Vercel → Settings → Environment Variables.

# Lozinka za /admin (obavezno).
ADMIN_PASSWORD=

# Neobavezno: zaseban ključ za potpis sesije. Bez njega se koristi ADMIN_PASSWORD.
SESSION_SECRET=

# Neon Postgres. Bez njega se lokalno koristi ugrađena baza u .data/pglite.
DATABASE_URL=

# Vercel Blob za slike. Bez njega se slike lokalno spremaju u public/uploads.
BLOB_READ_WRITE_TOKEN=

# Google Cloud Translation API ključ za automatski EN prijevod.
GOOGLE_TRANSLATE_API_KEY=

# Base URL of the Payload CMS (folder cms/). Default for dev: http://localhost:3100.
# If the CMS is down, the site uses the static data.
CMS_URL=http://localhost:3100

# Optional: the URL that the browser uses for CMS media, if it differs from CMS_URL.
CMS_PUBLIC_URL=
