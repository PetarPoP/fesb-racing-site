# Local secrets go in .dev.vars (read by the Cloudflare local proxy). This file only lists the names.
# Never put a real secret in this file.
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-hex-32
# URL of the TanStack site, used by live preview.
FRONTEND_URL=http://localhost:3000
# Used only by the seed script.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-password
# Deploy hook URL. A publish in the CMS calls it, and the site is built again. Empty = no rebuild.
# Set it as a Worker secret in production. See the root README and DEPLOY.md.
REBUILD_WEBHOOK_URL=
# Only for a GitHub repository_dispatch URL (https://api.github.com/repos/OWNER/REPO/dispatches).
# A fine-grained token with "Contents: read and write". Empty for a Cloudflare deploy hook.
REBUILD_WEBHOOK_TOKEN=
